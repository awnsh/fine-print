{
  "manifest_version": 3,
  "name": "Fine Print",
  "version": "0.1.0",
  "description": "Roasts Terms of Service and privacy policies in one blunt sentence, with receipts. Uses Chrome's free on-device AI: no account, no API key, nothing leaves your computer.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Fine Print",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options/index.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "offscreen", "scripting", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
